# Backend environment file template
# Neon example (recommended for your setup):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Local Postgres example:
# DATABASE_URL=postgresql://job_user:job_password_secure@localhost:5432/job_automation
DATABASE_URL=postgresql://<neon_user>:<neon_password>@<neon_host>/<neon_database>?sslmode=require
REDIS_URL=redis://localhost:6379/0

DEBUG=true
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Claude API Key - Get from https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-key-here

# Naukri Credentials
NAUKRI_EMAIL=your_naukri_email@gmail.com
NAUKRI_PASSWORD=your_naukri_password

# LinkedIn Credentials
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
AUTH_ENABLED=true
AUTH_AUTO_PROVISION_USERS=false
RESUME_RETENTION_DAYS=15
DEFAULT_SCHEDULE_TIMEZONE=Asia/Kolkata

# When AUTH_ENABLED=true, use /api/auth/register and /api/auth/login,
# then send Authorization: Bearer <token> for protected resources.

# SMTP (required for /api/jobs/digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# Scraping Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=5

# Upload security
# Keep extensions as .pdf and .docx in code for strict validation.
# MIME values are validated server-side; do not allow broad wildcard types.

# Rate Limiting
RATE_LIMIT_JOBS_PER_MINUTE=60
RATE_LIMIT_APPLICATIONS_PER_HOUR=100
