# Database Connection (PostgreSQL with pgvector extension or SQLite)
DATABASE_URL=sqlite:///./clearhire.db
# For PostgreSQL: postgresql://user:password@localhost:5432/clearhire

# Environment & Server
ENVIRONMENT=development
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Authentication
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
AUTH_ENABLED=true
AUTH_AUTO_PROVISION_USERS=false

# Retention & Policies
RESUME_RETENTION_DAYS=15
DEFAULT_SCHEDULE_TIMEZONE=Asia/Kolkata
RATE_LIMIT_APPLICATIONS_PER_HOUR=10

# AI & RAG Configuration
RAG_SIMILARITY_THRESHOLD=0.35
RAG_ABSTAIN_THRESHOLD=0.55
RAG_RECONCILE_MIN_OVERLAP=0.5
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Optional External Sourcing Credentials
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# Optional Notification Channels (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=true
